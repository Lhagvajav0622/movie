# Copy to .env.local and fill in.

# Postgres (Neon, Singapore region recommended)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=change-me-32-chars-min
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMS for OTP. Leave all empty in dev: codes are printed to the server log and shown on screen (demo mode).
# CallPro Text: SMS_PROVIDER=callpro, the API key (Vercel only, never git) and the line number CallPro gave you.
# SMS_API_URL is optional (overrides https://api-text.callpro.mn/v1/sms); with only SMS_API_URL set, a generic Bearer gateway is used.
# On production also set OTP_DEMO=0, so a missing key can never bring the on-screen codes back.
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER=
SMS_API_URL=
OTP_DEMO=

# Video (Cloudflare R2 + Worker)
# Used by the app (Vercel):
VIDEO_BASE_URL=https://mhub-video.<your-subdomain>.workers.dev
VIDEO_SIGNING_SECRET=same-value-as-the-worker-SIGNING_SECRET
# Used by the upload script on your computer (npm run video) AND by the admin poster upload on Vercel
# (add the same four R2_* values to Vercel; the Worker must be redeployed once to serve /img/*):
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mhub-videos

# Payments. "test" (default): QPay/SocialPay buttons use a fake provider, buyers confirm with one click.
# Set to "live" before real launch (needs the QPay/SocialPay providers implemented + credentials below).
PAYMENT_MODE=test

# Public site address (used for the QPay callback URL). Must be the live https address.
NEXT_PUBLIC_SITE_URL=https://kinohorom.mn

# QPay V2 (merchant.qpay.mn). Put the real values only in Vercel, never in git.
QPAY_BASE_URL=https://merchant.qpay.mn
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
